{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @workspace/adalat-ai run dev",
    "dev:api": "pnpm --filter @workspace/api-server run dev",
    "dev:ai": "cd artifacts/ai-service && python -m uvicorn app.main:app --port 8000 --reload",
    "dev:all": "pnpm --parallel --filter @workspace/adalat-ai --filter @workspace/api-server run dev",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:seed": "node ./scripts/seed.mjs",
    "statutes:ingest": "node ./scripts/ingest-statutes.mjs",
    "statutes:reindex": "node ./scripts/ingest-statutes.mjs --force",
    "statutes:verify": "python ./scripts/verify-statutes.py",
    "simulate-courtroom": "pnpm --filter @workspace/api-server run simulate-courtroom",
    "eval": "cd artifacts/ai-service && python -m eval.run_eval",
    "eval:courtroom": "cd artifacts/ai-service && python -m eval.courtroom_eval",
    "eval:redteam": "cd artifacts/ai-service && python -m eval.redteam_eval",
    "eval:witness": "cd artifacts/ai-service && python -m eval.witness_eval",
    "eval:ui": "cd artifacts/ai-service && python -m mlflow ui --backend-store-uri sqlite:///mlflow.db",
    "preinstall": "node ./scripts/preinstall.mjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
